# Copy to .env.local (gitignored) and fill in real values.
# Same three variables must also be set in Vercel → Project Settings → Environment Variables.

# Supabase project URL (Project Settings → API in the Supabase dashboard).
# No NEXT_PUBLIC_ prefix — this is only ever read server-side.
SUPABASE_URL=

# Supabase service role key — server-only, never exposed to the browser (same page as above).
SUPABASE_SERVICE_ROLE_KEY=

# Random secret Vercel Cron sends back as "Authorization: Bearer <value>" to authenticate
# calls to /api/cron/refresh-metrics. Generate any long random string.
CRON_SECRET=

# Google Analytics 4 measurement ID (Admin → Data streams → your stream, in the GA dashboard).
# Public by design — inlined into the client bundle to load gtag.js.
NEXT_PUBLIC_GA_ID=
